# Copy to .env at project root and adjust. All values below are defaults
# (config.py reads these vars, falling back to the same defaults).

# Paths
DATA_DIR=data
CHUNKS_DIR=data/chunks
QA_DIR=data/qa_pairs
CHROMA_DB_PATH=data/chroma_db

# Models
EMBED_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
LLM_MODEL=qwen3.5:9b
QA_GEN_MODEL=qwen3.6:35b
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama

# RAG parameters
COLLECTION_NAME=ming_military
TOP_K=5
RERANK_TOP_K=4

# Chunking (token-aware, bge-m3 tokenizer)
CHUNK_TOKENS=512
OVERLAP_TOKENS=64

# CORS (comma-separated origins, localhost-only by default)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
